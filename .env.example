# Chép file này thành .env rồi điền giá trị của bạn. Không gửi .env cho người khác.

# 9router AI Gateway Configuration
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_IMAGE_MODEL=ag/gemini-3.1-flash-image
NINEROUTER_LLM_MODEL=ag/gemini-3.8-flash-high
# Model chia kịch bản thành cảnh: bản -low nhanh hơn nhiều mà vẫn kể đủ
NINEROUTER_SCENE_MODEL=ag/gemini-3.8-flash-low

# Server & Defaults Configuration
STORY_STUDIO_HOST=127.0.0.1
STORY_STUDIO_PORT=8000
DEFAULT_VOICE=vi-VN-NamMinhNeural
DEFAULT_STYLE=manga_murata_battle
DEFAULT_IMAGE_PROVIDER=meta_muse_cloud

# Security (backend/security.py)
# Server chỉ nhận request từ chính máy này (Fleet Runner chạy cùng máy, gọi qua 127.0.0.1).
# Giới hạn dung lượng mỗi file upload (MB)
STORY_STUDIO_MAX_UPLOAD_MB=200
# Hostname/origin bổ sung được phép (phân tách bằng dấu phẩy), mặc định chỉ localhost
STORY_STUDIO_ALLOWED_HOSTS=
STORY_STUDIO_ALLOWED_ORIGINS=

# Khoá dịch vụ tuỳ chọn: để trống thì nhánh đó tự bỏ qua
# Chia cảnh gọi Gemini trực tiếp hoặc OpenRouter khi không có NINEROUTER_API_KEY
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Nguồn ảnh "OpenAI DALL-E 3" (cần cài thêm thư viện openai)
OPENAI_API_KEY=
# Gói SEO YouTube: xem tiêu đề, tags của video đứng đầu tìm kiếm (YouTube Data API v3, key miễn phí của Google Cloud)
YOUTUBE_API_KEY=

# Server giọng VieNeu (tự bật bằng uv, giữ model trong RAM)
VIENEU_HOST=127.0.0.1
VIENEU_PORT=5005
# Tốc độ đọc VieNeu (1.0 = gốc, mặc định 0.87 cho chậm, có không khí)
VIENEU_SPEED=0.87

# Công tắc (1 = bật). Dùng cho test hoặc server thử; chạy bình thường thì để trống
# Không tự bật Fleet Runner (Muse)
STORY_STUDIO_DISABLE_FLEET_AUTOSTART=
# Server không chạy hàng việc phân tích vụ án (khỏi tự chạy tiếp vụ dở, tốn LLM)
STORY_STUDIO_DISABLE_CASE_WORKER=
# Không tự bật server giọng VieNeu
STORY_STUDIO_DISABLE_VIENEU_AUTOSTART=

# Số phút tối đa chờ Muse làm xong một cảnh video cao trào (giao việc nhiều bước), mặc định 75
STORY_STUDIO_MUSE_AGENT_WAIT_MIN=

# Thư mục profile Chrome đã đăng nhập Muse của app khác dùng chung (vd thư mục chrome_profiles của
# videopic-workflow), nhiều thư mục cách nhau bằng dấu chấm phẩy
STORY_STUDIO_EXTRA_CHROME_PROFILES=
